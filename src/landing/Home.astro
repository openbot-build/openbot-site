---
import "@fontsource-variable/dm-sans/opsz.css"
import "@fontsource/dm-mono/400.css"
import "@fontsource/dm-mono/500.css"
import { docsPath, homeLocales, type HomeLocale } from "../i18n.ts"
import { docsUrl } from "../links.ts"
import { messagesFor } from "./messages/index.ts"
import { ArrowUpRight, Globe, ChevronDown, Check } from "@lucide/astro"
import Experience from "./Experience.astro"
import SiteIcons from "./SiteIcons.astro"
import TechnicalContent from "./TechnicalContent.astro"
import "./landing.css"
interface Props { locale: HomeLocale; technical?: boolean }
const { locale, technical = false } = Astro.props
const m = messagesFor(locale.path)
const home = locale.path ? `/${locale.path}/` : "/"
const docs = docsPath(locale.path)
const pagePath = `${home}${technical ? "developers/" : ""}`
const title = technical ? m.product.developers : m.hero.title.join(" ")
const description = technical ? m.description : `OpenBot. ${m.product.core} ${m.product.ui} ${m.product.title}`
---
<!doctype html>
<html lang={locale.lang} dir={locale.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenBot — {title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <SiteIcons />
    <link rel="canonical" href={`https://openbot.build${pagePath}`} />
    {homeLocales.map(l => <link rel="alternate" hreflang={l.lang} href={`https://openbot.build${l.path ? `/${l.path}/` : "/"}${technical ? "developers/" : ""}`} />)}
    <link rel="alternate" hreflang="x-default" href={`https://openbot.build/${technical ? "developers/" : ""}`} />
    <meta property="og:title" content={`OpenBot — ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://openbot.build${pagePath}`} />
  </head>
  <body>
    <header class="header wrap">
      <a class="wordmark" href={home} aria-label="OpenBot"><img class="brand-logo" src="/OB.svg" width="40" height="40" alt="" />OpenBot</a>
      <nav aria-label={m.nav.label}>
        <a class="nav-link" href={`${home}developers/`}>{m.product.developers}</a>
        <a class="nav-link" href={docs}>{m.nav.docs} <ArrowUpRight size={20} aria-hidden="true" /></a>
        <details class="language">
          <summary aria-label={m.nav.language}><Globe size={18} aria-hidden="true" /><span>{locale.name}</span><ChevronDown size={14} aria-hidden="true" /></summary>
          <div class="language-menu">{homeLocales.map(l => <a href={`${l.path ? `/${l.path}/` : "/"}${technical ? "developers/" : ""}`} lang={l.lang} dir={l.dir} aria-current={l.path === locale.path ? "page" : undefined}>{l.name}{l.path === locale.path && <Check size={16} aria-hidden="true" />}</a>)}</div>
        </details>
        {technical && <a class="button small" href={`${docs}developers/quickstart/`}>{m.hero.quickStart}<ArrowUpRight size={20} aria-hidden="true" /></a>}
      </nav>
    </header>
    {technical ? <TechnicalContent m={m} docs={docs} /> : <Experience m={m} developerPath={`${home}developers/`} />}
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <p class="footer-tagline">{m.hero.title.join(" ")}</p>
          <nav class="footer-links" aria-label={m.product.developers}>
            <p class="footer-heading">{m.product.developers}</p>
            <a href={home}>OpenBot</a>
            <a href={`${home}developers/`}>{m.product.developers}</a>
            <a href="https://github.com/openbot-build/openbot-ui">OpenBot UI {m.linkLabels.source} <ArrowUpRight size={14} aria-hidden="true" /></a>
            <a href="https://github.com/openbot-build/openbot">OpenBot {m.linkLabels.source} <ArrowUpRight size={14} aria-hidden="true" /></a>
          </nav>
          <nav class="footer-links" aria-label={m.nav.docs}>
            <p class="footer-heading">{m.nav.docs}</p>
            <a href={docs}>{m.nav.docs}</a>
            <a href={`${docs}quickstart/`}>{m.hero.quickStart}</a>
            <a href={docsUrl("/api/")}>{m.hero.apiReference} <ArrowUpRight size={14} aria-hidden="true" /></a>
          </nav>
        </div>
        <div class="footer-signature" dir="ltr">
          <div class="footer-brand">OpenBot</div>
          <p class="footer-copyright">© {new Date().getFullYear()} OpenBot</p>
        </div>
      </div>
    </footer>
    <script>
      const language = document.querySelector<HTMLDetailsElement>('.language')
      document.addEventListener('click', event => { if (language && event.target instanceof Node && !language.contains(event.target)) language.open = false })
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && language?.open) { language.open = false; language.querySelector('summary')?.focus() } })
    </script>
  </body>
</html>
